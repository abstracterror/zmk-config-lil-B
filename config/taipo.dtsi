#define TCOMBO(NAME, BINDINGS, OUTER_BINDINGS, INNER_BINDINGS, BOTH_BINDINGS, LEFT_KEYPOS, RIGHT_KEYPOS) \
combo_l_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <BINDINGS>; \
	key-positions = <LEFT_KEYPOS>; \
	layers = <COMBO_LAYERS>; \
}; \
combo_li_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <INNER_BINDINGS>; \
	key-positions = <LEFT_KEYPOS LIT>; \
	layers = <COMBO_LAYERS>; \
}; \
combo_lo_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <OUTER_BINDINGS>; \
	key-positions = <LEFT_KEYPOS LOT>; \
	layers = <COMBO_LAYERS>; \
}; \
combo_lb_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <BOTH_BINDINGS>; \
	key-positions = <LEFT_KEYPOS LIT LOT>; \
	layers = <COMBO_LAYERS>; \
}; \
combo_r_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <BINDINGS>; \
	key-positions = <RIGHT_KEYPOS>; \
	layers = <COMBO_LAYERS>; \
}; \
combo_ri_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <INNER_BINDINGS>; \
	key-positions = <RIGHT_KEYPOS RIT>; \
	layers = <COMBO_LAYERS>; \
}; \
combo_ro_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <OUTER_BINDINGS>; \
	key-positions = <RIGHT_KEYPOS ROT>; \
	layers = <COMBO_LAYERS>; \
}; \
combo_rb_##NAME { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <BOTH_BINDINGS>; \
	key-positions = <RIGHT_KEYPOS RIT ROT>; \
	layers = <COMBO_LAYERS>; \
};

combo_l_space { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <&kp SPACE>; \
	key-positions = <LOT>; \
	layers = <COMBO_LAYERS>; \
};

combo_r_space { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <&kp SPACE>; \
	key-positions = <ROT>; \
	layers = <COMBO_LAYERS>; \
};

combo_l_bspc { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <&kp BSPC>; \
	key-positions = <LIT>; \
	layers = <COMBO_LAYERS>; \
};

combo_r_bspc { \
	timeout-ms = <COMBO_TIMEOUT>; \
	bindings = <&kp BSPC>; \
	key-positions = <RIT>; \
	layers = <COMBO_LAYERS>; \
};

combo_l_repeat { \
    timeout-ms = <COMBO_TIMEOUT>; \
    bindings = <&key_repeat>; \
    key-positions = <LIT LOT>; \
    layers = <COMBO_LAYERS>; \
};

combo_r_repeat { \
    timeout-ms = <COMBO_TIMEOUT>; \
    bindings = <&key_repeat>; \
    key-positions = <RIT ROT>; \
    layers = <COMBO_LAYERS>; \
};

/ {
    behaviors {
        fnkey0: fnkey0 {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            f1 { sequence = <N1>; bindings = <&kp F1>; };
            f2 { sequence = <N2>; bindings = <&kp F2>; };
            f3 { sequence = <N3>; bindings = <&kp F3>; };
            f4 { sequence = <N4>; bindings = <&kp F4>; };
            f5 { sequence = <N5>; bindings = <&kp F5>; };
            f6 { sequence = <N6>; bindings = <&kp F6>; };
            f7 { sequence = <N7>; bindings = <&kp F7>; };
            f8 { sequence = <N8>; bindings = <&kp F8>; };
            f9 { sequence = <N9>; bindings = <&kp F9>; };
            f10 { sequence = <N0>; bindings = <&kp F10>; };
        };

        fnkey1: fnkey1 {
            compatible = "zmk,behavior-leader-key";
            #binding-cells = <0>;
            f11 { sequence = <N1>; bindings = <&kp F11>; };
            f12 { sequence = <N2>; bindings = <&kp F12>; };
            f13 { sequence = <N3>; bindings = <&kp F13>; };
            f14 { sequence = <N4>; bindings = <&kp F14>; };
            f15 { sequence = <N5>; bindings = <&kp F15>; };
            f16 { sequence = <N6>; bindings = <&kp F16>; };
            f17 { sequence = <N7>; bindings = <&kp F17>; };
            f18 { sequence = <N8>; bindings = <&kp F18>; };
            f19 { sequence = <N9>; bindings = <&kp F19>; };
            f20 { sequence = <N0>; bindings = <&kp F20>; };
        };
    };
};

TCOMBO(R,      &kp R,      &kp LS(R), &kp GT,     &kp PSCRN,    TLP,         TRP)
TCOMBO(S,      &kp S,      &kp LS(S), &kp RBRC,   &kp C_BRI_UP, TLR,         TRR)
TCOMBO(N,      &kp N,      &kp LS(N), &kp RBKT,   &kp C_BRI_DN, TLM,         TRM)
TCOMBO(I,      &kp I,      &kp LS(I), &kp RPAR,   &kp C_PP,     TLI,         TRI)
TCOMBO(A,      &kp A,      &kp LS(A), &kp LT,     &kp C_NEXT,   BLP,         BRP)
TCOMBO(O,      &kp O,      &kp LS(O), &kp LBRC,   &kp C_VOL_UP, BLR,         BRR)
TCOMBO(T,      &kp T,      &kp LS(T), &kp LBKT,   &kp C_VOL_DN, BLM,         BRM)
TCOMBO(E,      &kp E,      &kp LS(E), &kp LPAR,   &kp C_PREV,   BLI,         BRI)
TCOMBO(C,      &kp C,      &kp LS(C), &kp N1,     &none,        BLR BLI,     BRR BRI)
TCOMBO(U,      &kp U,      &kp LS(U), &kp N2,     &none,        BLR BLM,     BRR BRM)
TCOMBO(Q,      &kp Q,      &kp LS(Q), &kp N3,     &none,        BLP BLM,     BRP BRM)
TCOMBO(L,      &kp L,      &kp LS(L), &kp N4,     &none,        BLP BLR,     BRP BRR)
TCOMBO(Y,      &kp Y,      &kp LS(Y), &kp N5,     &none,        TLM TLI,     TRM TRI)
TCOMBO(F,      &kp F,      &kp LS(F), &kp N6,     &none,        TLR TLI,     TRR TRI)
TCOMBO(P,      &kp P,      &kp LS(P), &kp N7,     &none,        TLR TLM,     TRR TRM)
TCOMBO(Z,      &kp Z,      &kp LS(Z), &kp N8,     &none,        TLP TLM,     TRP TRM)
TCOMBO(B,      &kp B,      &kp LS(B), &kp N9,     &none,        TLP TLR,     TRP TRR)
TCOMBO(H,      &kp H,      &kp LS(H), &kp N0,     &none,        BLM BLI,     BRM BRI)
TCOMBO(D,      &kp D,      &kp LS(D), &kp AT,     &none,        BLP BLI,     BRP BRI)
TCOMBO(G,      &kp G,      &kp LS(G), &kp HASH,   &none,        TLP TLI,     TRP TRI)
TCOMBO(X,      &kp X,      &kp LS(X), &kp CARET,  &kp LC(X),    TLP BLM,     TRP BRM)
TCOMBO(K,      &kp K,      &kp LS(K), &kp PLUS,   &kp LC(C),    TLI BLR,     TRI BRR)
TCOMBO(V,      &kp V,      &kp LS(V), &kp STAR,   &kp LC(V),    TLR BLI,     TRR BRI)
TCOMBO(J,      &kp J,      &kp LS(J), &kp EQUAL,  &kp LC(Z),    TLM BLP,     TRM BRP)
TCOMBO(M,      &kp M,      &kp LS(M), &kp DOLLAR, &none,        TLP BLI,     TRP BRI)
TCOMBO(W,      &kp W,      &kp LS(W), &kp AMPS,   &none,        TLI BLP,     TRI BRP)
TCOMBO(SLASH,  &kp SLASH,  &kp BSLH,  &kp PIPE,   &none,        TLR BLM,     TRR BRM)
TCOMBO(MINUS,  &kp MINUS,  &kp UNDER, &kp PRCNT,  &none,        TLM BLR,     TRM BRR)
TCOMBO(QMARK,  &kp QMARK,  &kp EXCL,  &caps_word, &none,        TLI BLM,     TRI BRM)
TCOMBO(COMMA,  &kp COMMA,  &kp DOT,   &kp TILDE,  &none,        TLM BLI,     TRM BRI)
TCOMBO(SEMI,   &kp SEMI,   &kp COLON, &none,      &none,        TLP BLR,     TRP BRR)
TCOMBO(SEMI2,  &kp SEMI,   &kp COLON, &none,      &none,        BLR TLM BLI, BRR TRM BRI)
TCOMBO(SQT,    &kp SQT,    &kp DQT,   &kp GRAVE,  &none,        TLR BLP,     TRR BRP)
TCOMBO(SQT2,   &kp SQT,    &kp DQT,   &kp GRAVE,  &none,        BLR TLM TLI, BRR TRM TRI)
TCOMBO(TAB,    &kp TAB,    &kp DEL,   &kp INS,    &bt BT_CLR,   TLR TLM TLI, TRR TRM TRI)
TCOMBO(ENTER,  &kp ENTER,  &kp ESC,   &kp LALT,   &bootloader,  BLR BLM BLI, BRR BRM BRI)
TCOMBO(LGUI,   &sk LGUI,   &kp RIGHT, &kp PGUP,   &bt BT_SEL 3, TLP BLP,     TRP BRP)
TCOMBO(LALT,   &sk LALT,   &kp UP,    &kp HOME,   &bt BT_SEL 2, TLR BLR,     TRR BRR)
TCOMBO(LCTRL,  &sk LCTRL,  &kp DOWN,  &kp END,    &bt BT_SEL 1, TLM BLM,     TRM BRM)
TCOMBO(LSHIFT, &sk LSHIFT, &kp LEFT,  &kp PGDN,   &bt BT_SEL 0, TLI BLI,     TRI BRI)
TCOMBO(FNKEY0, &fnkey0,    &none,     &none,      &none,        BLP BLR BLM, BRM BRR BRP)
TCOMBO(FNKEY1, &fnkey1,    &none,     &none,      &none,        TLP TLR TLM, TRM TRR TRP)
